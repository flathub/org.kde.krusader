{
    "app-id": "org.kde.krusader",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "command": "krusader",
    "rename-icon": "krusader_user",
    "finish-args": [
        "--device=dri",
        "--filesystem=/media",
        "--filesystem=/run/media",
        "--filesystem=home",
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--system-talk-name=org.freedesktop.UDisks2",
        "--talk-name=org.kde.StatusNotifierWatcher"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/doc",
        "/share/man",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "lhasa",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/fragglet/lhasa/releases/download/v0.6.0/lhasa-0.6.0.tar.gz",
                    "sha256": "9840154367f73e9d9c3196f944a121ab4d398d84e921c8fe8fca8a931274aed7",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 14822,
                        "url-template": "https://github.com/fragglet/lhasa/releases/download/v$version/lhasa-$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "unrar",
            "no-autogen": true,
            "build-options": {
                "strip": true
            },
            "make-install-args": [
                "DESTDIR=$(FLATPAK_DEST)"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://www.rarlab.com/rar/unrarsrc-5.8.3.tar.gz",
                    "sha256": "3591685c8f5bbcb0be09de3d0a0544adb88966b9cccb80986f6cd2b534fd91a6"
                }
            ]
        },
        {
            "name": "7zip",
            "buildsystem": "simple",
            "subdir": "CPP/7zip/Bundles/Alone7z",
            "build-commands": [
                "make -j $FLATPAK_BUILDER_N_JOBS -f makefile.gcc",
                "install -D ./_o/7zr -t /app/bin",
                "ln -s /app/bin/7zr /app/bin/7z"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/ip7z/7zip/archive/refs/tags/26.06.tar.gz",
                    "sha256": "63bbf0ede83e4286ec8a2905ed732a12acc36dd4771984d870b054240ce761fa",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 372314,
                        "url-template": "https://github.com/ip7z/7zip/archive/refs/tags/$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "krusader",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/krusader/2.9.0/krusader-2.9.0.tar.xz",
                    "sha256": "c9b79bfade6cc69fe0e341ecef932fcac8afd9fe94e8cbcfbd729feb54394e04",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 9651,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/krusader/$version/krusader-$version.tar.xz"
                    }
                }
            ]
        }
    ]
}
